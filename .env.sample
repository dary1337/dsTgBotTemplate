# --- MongoDB (required) ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=ds-tg-bot-template

# --- Bots (at least one token is required) ---
DS_BOT_TOKEN=
TG_BOT_TOKEN=

# Comma-separated Telegram user IDs seeded as admins on first run (migration 001)
SEED_TG_ADMIN_IDS=

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs
