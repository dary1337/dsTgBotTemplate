{
    "name": "ds-tg-bot-template",
    "version": "1.0.0",
    "description": "Template for a Discord and Telegram bot stack with MongoDB, TypeScript, and Docker support.",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env ./src/index.ts",
        "start": "node --env-file-if-exists=.env ./dist/index.js",
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "format": "prettier --write \"{src,tests,examples}/**/*.ts\"",
        "format:check": "prettier --check \"{src,tests,examples}/**/*.ts\"",
        "test": "tsx --test \"tests/**/*.test.ts\""
    },
    "keywords": [
        "discord",
        "discord.js",
        "telegram",
        "telegraf",
        "mongodb",
        "typescript",
        "bot",
        "template",
        "boilerplate",
        "starter"
    ],
    "author": "yuri",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "cron": "^4.4.0",
        "discord.js": "^14.27.0",
        "mongodb": "^7.5.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "pino-roll": "^4.0.0",
        "telegraf": "^4.16.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.1",
        "eslint": "^10.7.0",
        "eslint-plugin-check-file": "^3.3.1",
        "globals": "^17.7.0",
        "prettier": "^3.9.5",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0"
    }
}
